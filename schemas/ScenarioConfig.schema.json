{
  "$defs": {
    "IncidentSpec": {
      "additionalProperties": false,
      "description": "The single abstract incident type of version 1.0: propagating compromise.",
      "properties": {
        "entry_node_id": {
          "maxLength": 40,
          "pattern": "^node-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Entry Node Id",
          "type": "string"
        },
        "incident_type": {
          "const": "propagating_compromise",
          "default": "propagating_compromise",
          "title": "Incident Type",
          "type": "string"
        },
        "spread_probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Spread Probability",
          "type": "number"
        },
        "start_step": {
          "minimum": 1,
          "title": "Start Step",
          "type": "integer"
        }
      },
      "required": [
        "entry_node_id",
        "start_step",
        "spread_probability"
      ],
      "title": "IncidentSpec",
      "type": "object"
    },
    "ObservabilitySpec": {
      "additionalProperties": false,
      "description": "How observable the incident is (alerts, delays, missing values).",
      "properties": {
        "alert_delay_max_steps": {
          "maximum": 5,
          "minimum": 0,
          "title": "Alert Delay Max Steps",
          "type": "integer"
        },
        "alert_detect_probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Alert Detect Probability",
          "type": "number"
        },
        "false_alert_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "False Alert Rate",
          "type": "number"
        },
        "missing_value_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Missing Value Rate",
          "type": "number"
        }
      },
      "required": [
        "alert_detect_probability",
        "false_alert_rate",
        "alert_delay_max_steps",
        "missing_value_rate"
      ],
      "title": "ObservabilitySpec",
      "type": "object"
    }
  },
  "$id": "urn:cyberswarm:schema:ScenarioConfig:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A scenario configuration (CONTRACTS section 7.4).",
  "properties": {
    "description": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9 .,()_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "incident": {
      "$ref": "#/$defs/IncidentSpec"
    },
    "max_steps": {
      "maximum": 500,
      "minimum": 5,
      "title": "Max Steps",
      "type": "integer"
    },
    "objective_node_id": {
      "anyOf": [
        {
          "maxLength": 40,
          "pattern": "^node-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Objective Node Id"
    },
    "observability": {
      "$ref": "#/$defs/ObservabilitySpec"
    },
    "observation_window_steps": {
      "maximum": 20,
      "minimum": 1,
      "title": "Observation Window Steps",
      "type": "integer"
    },
    "restore_duration_steps": {
      "maximum": 10,
      "minimum": 1,
      "title": "Restore Duration Steps",
      "type": "integer"
    },
    "scenario_id": {
      "pattern": "^scn-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "topology_id": {
      "pattern": "^topo-[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$",
      "title": "Topology Id",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "topology_id",
    "max_steps",
    "observation_window_steps",
    "incident",
    "observability",
    "restore_duration_steps",
    "objective_node_id"
  ],
  "title": "ScenarioConfig",
  "type": "object"
}
