{
  "$defs": {
    "ComparisonUnit": {
      "description": "The pairing unit of a comparison.",
      "enum": [
        "matched_pair",
        "training_seed"
      ],
      "title": "ComparisonUnit",
      "type": "string"
    },
    "MetricDifference": {
      "additionalProperties": false,
      "description": "A paired difference for one metric (candidate minus baseline).",
      "properties": {
        "ci_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci High"
        },
        "ci_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Low"
        },
        "mean_difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Difference"
        },
        "n_pairs": {
          "minimum": 1,
          "title": "N Pairs",
          "type": "integer"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9 .,()_-]+$",
          "title": "Name",
          "type": "string"
        },
        "scorer_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9 .,()_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scorer Id"
        }
      },
      "required": [
        "name",
        "n_pairs"
      ],
      "title": "MetricDifference",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a measured or compared record's values came from.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProvenanceKind"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9 .,()_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceKind": {
      "description": "Where a record's values came from.",
      "enum": [
        "fixture_synthetic",
        "mock_simulator_run",
        "simulator_run"
      ],
      "title": "ProvenanceKind",
      "type": "string"
    },
    "Representation": {
      "description": "Observation representation of a policy arm.\n\n``learned_embedding`` names the staged learned-graph experiment and is part\nof version 1.0 so that adding that stage is not a contract change; no record\ncarries it unless that stage ran.",
      "enum": [
        "conventional",
        "graph_features",
        "learned_embedding"
      ],
      "title": "Representation",
      "type": "string"
    },
    "Split": {
      "description": "Dataset split.\n\n``eval`` holds held-out scenarios on the training topology; ``eval_utopo``\nholds held-out scenarios on the unseen topology variant. ``cal`` is used\nonly for threshold selection, calibration and model selection and is never\nreported as a result.",
      "enum": [
        "train",
        "cal",
        "eval",
        "eval_utopo",
        "dev",
        "fixture"
      ],
      "title": "Split",
      "type": "string"
    }
  },
  "$id": "urn:cyberswarm:schema:ComparisonRecord:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Paired comparison of two policy families (CONTRACTS section 11.3).",
  "properties": {
    "baseline_policy_family_id": {
      "pattern": "^fam-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Baseline Policy Family Id",
      "type": "string"
    },
    "baseline_representation": {
      "$ref": "#/$defs/Representation"
    },
    "candidate_policy_family_id": {
      "pattern": "^fam-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Candidate Policy Family Id",
      "type": "string"
    },
    "candidate_representation": {
      "$ref": "#/$defs/Representation"
    },
    "comparison_id": {
      "pattern": "^cmp-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Comparison Id",
      "type": "string"
    },
    "differences": {
      "items": {
        "$ref": "#/$defs/MetricDifference"
      },
      "title": "Differences",
      "type": "array"
    },
    "matched_set_id": {
      "pattern": "^set-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Matched Set Id",
      "type": "string"
    },
    "n_pairs": {
      "minimum": 1,
      "title": "N Pairs",
      "type": "integer"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "run_id": {
      "pattern": "^run-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "$ref": "#/$defs/Split"
    },
    "unit": {
      "$ref": "#/$defs/ComparisonUnit"
    }
  },
  "required": [
    "comparison_id",
    "run_id",
    "matched_set_id",
    "split",
    "baseline_policy_family_id",
    "candidate_policy_family_id",
    "baseline_representation",
    "candidate_representation",
    "unit",
    "n_pairs",
    "provenance"
  ],
  "title": "ComparisonRecord",
  "type": "object"
}
